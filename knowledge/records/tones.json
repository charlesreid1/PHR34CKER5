  {
    "id": "mf_kp2_intl",
    "name": "MF R1 control code at 1300+1700 Hz (KP2 / international)",
    "aliases": ["KP2", "international KP", "KP prime"],
    "category": "tone_signal",
    "region": "NANP",
    "signaling_layer": "co_to_co_inband_trunk",
    "era_bounds": ["1960-01-01", "1992-12-31"],
    "confidence": "secondary",
    "technical_body": {"frequencies_hz": [1300, 1700], "tolerance": "±1.5%", "level_dBm0": -7, "pattern": "international / special-routing key pulse in Bellcore/later-Bell notation"},
    "disputed": {
      "naming": "1300+1700 Hz is 'KP2' (international) in Bellcore TR-NPL-000275 notation, but BSTJ 1960 does not name it (has only one KP). Community canon sometimes calls it KP' or mislabels 700+1700 as 'KP2'. Never assert 'KP2 is X Hz' without stating the naming scheme.",
      "competing_values": "BSTJ 1960: 700+1700 = Code 11, 900+1700 = Code 12, no KP2 concept. Bellcore: KP2 = 1300+1700, ST2P = 900+1700, ST3P = 700+1700."
    },
    "citations": ["tr-npl-000275", "bstj-1960-11"],
    "see_also": ["mf_kp", "mf_st"]
