  {
    "id": "ccitt5_line_seize",
    "name": "CCITT No.5 line seizure tone",
    "aliases": ["C5 seizure", "2400 Hz seizure", "international seizure"],
    "category": "tone_signal",
    "region": "CCITT-No5",
    "signaling_layer": "co_to_co_inband_trunk_international",
    "era_bounds": ["1964-01-01", "1990-12-31"],
    "confidence": "primary",
    "technical_body": {
      "frequencies_hz": [2400],
      "pattern": "2400 Hz = seizure; 2600 Hz = proceed-to-send; answer/clear-back/clear-forward encoded as pulse patterns of 2400 and 2600 used singly and combined",
      "note": "Inter-register (address) signals reuse the R1 MF set (700-1700). A tone generator that only emits 2600 Hz will NOT seize a No.5 international trunk."
    },
    "disputed": {
      "persistence": "Community memory reports vulnerable No.5 gateways on Caribbean/West African routes into the mid-1990s; primary ITU switching-plan confirmation is spotty. Mark community-provenance."
    },
    "citations": ["ccitt-q-blue-1988"],
    "see_also": ["sf_2600", "mf_kp"]
