  {
    "id": "x25_dnic_3110_sprintnet",
    "name": "Sprintnet / Telenet (US) — DNIC 3110",
    "aliases": ["Telenet", "Sprintnet", "DNIC 3110", "PC Pursuit"],
    "category": "data_network",
    "region": "US",
    "signaling_layer": "x25_packet",
    "era_bounds": ["1975-01-01", "2004-12-31"],
    "confidence": "primary",
    "technical_body": {
      "dnic": "3110",
      "operator": "Bolt Beranek & Newman — Telenet; sold to GTE 1979; sold to Sprint 1986 (renamed Sprintnet); MCI/Verizon Business era 2000s",
      "public_pads": ["1-800-546-1000", "1-800-877-5045"],
      "post_connect": "Send <CR><CR>. '@' prompt appears. TERM=D1 sets VT100 emulation. `C <NUA>` connects to a host.",
      "local_address_format": "AAAB-CCC where AAA = area code, B = 0-9 area suffix, CCC = host index. Scanners like Ranger and Scan-o-matic walked this space.",
      "notable": "Backed Compuserve, dozens of BBS and mainframe outdials; the 'PC Pursuit' service (~$30/mo flat) turned it into a national free-dial network for hobbyists 1987-1993."
    },
    "citations": ["ccitt-x121", "sprintnet-directory"],
    "see_also": ["x25_dnic_3106_tymnet", "x25_dnic_3125_accunet"]
  },
