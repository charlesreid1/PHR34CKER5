# PHR34CKER5 — source this file (`. ./.env`) before running Claude in this dir.
# Copy to .env and fill in. .env is gitignored.

# --- Twilio (required for live-call tools) ---
export TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export TWILIO_AUTH_TOKEN="your_auth_token_here"
export TWILIO_FROM_NUMBER="+15555550123"   # E.164, must be a Twilio number on this account

# --- Tunnel: pick ONE topology ---
# A) Laptop mode (default): ngrok punches a tunnel. Free token at ngrok.com.
export NGROK_AUTHTOKEN=""

# B) VPS mode: set the public HTTPS URL your reverse-proxy exposes and leave NGROK_AUTHTOKEN blank.
# export PHR34CKER5_PUBLIC_URL="https://phreak.example.com"
# export PHR34CKER5_BIND_HOST="127.0.0.1"
# export PHR34CKER5_BIND_PORT="8787"

# --- Guardrails ---
# Auto-hangup any call older than this many minutes. Belt+suspenders on the 1-hour <Pause>.
export MAX_CALL_MINUTES="10"

# --- Where synthesized tone WAVs land (optional) ---
# export PHR34CKER5_TONE_DIR="$PWD/.tones"

# --- Point the MCP at the in-repo knowledge dir (so edits show up live) ---
export PHR34CKER5_KNOWLEDGE="$PWD/knowledge"
